    "@tanstack/react-query": "^5.104.5",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "nuqs": "^2.10.2",
    "postgres": "^3.4.9",
